  "narrative": {
    "northStar": "The Field Ledger",
    "overview": "Prism looks like a governed record kept on paper. The ground is warm cream, headings are set in a bookish serif, labels and identifiers in mono, and every figure sits in a ruled panel where it can be traced. Nothing is decorative: depth comes from tonal layers and one-pixel hairlines, colour carries a small number of fixed meanings, and a symbol and a word always travel with it.",
    "keyCharacteristics": [
      "Warm paper ground with a faint dot grid; cards are a half-step lighter than the page.",
      "One accent (pine) for action and lit; ember only for gaps and failures; slate only for compliant.",
      "Serif for headings and large figures, sans for reading, mono for labels, IDs and measurements.",
      "Flat at rest: hairline borders, no resting shadows.",
      "Two themes from one token set: Paper and Pine (default) and Ink and lit glow (dark).",
      "Every state is glyph plus word plus colour, never colour alone."
    ],
    "rules": [
      {
        "name": "The One Lit Accent Rule",
        "body": "Pine is the only accent. If a second colour is needed to say something, it is ember (a gap) or slate (compliant), and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Never Alone Rule",
        "body": "A colour never carries a meaning alone. Verdicts, gate status and table states always pair it with a glyph and a word.",
        "section": "colors"
      },
      {
        "name": "The Beside, Never Merged Rule",
        "body": "Deployed and compliant are drawn side by side in their own colours. No blended or averaged figure exists.",
        "section": "colors"
      },
      {
        "name": "The Mono Is For Records Rule",
        "body": "Mono marks identifiers, counts, status words and column heads. It never decorates a heading.",
        "section": "typography"
      },
      {
        "name": "The Fixed Scale Rule",
        "body": "Sizes are fixed rem steps (ratio about 1.2), not fluid. Density changes by stepping down one named size at the desk breakpoint, never by scaling.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "A surface has a shadow only when it has left the page (a popover, a floating table, a drawer). Cards never do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every colour from the token set; the Ink theme must work with no component changes.",
      "Do show deployed beside compliant, in pine and slate, wherever a rate appears.",
      "Do pair every colour state with a glyph and a word, and keep contrast at 4.5:1 for text.",
      "Do keep numbers in tabular figures and wrap identifiers in bdi dir=ltr so they survive right-to-left.",
      "Do keep depth to hairlines and tonal layers; use a shadow only for a popover, a floating table, or the drawer.",
      "Do step density down at the desk and short breakpoints by changing a named size, not by scaling.",
      "Do label simulated or fictitious data (the Synthetic data badge stays on every federal screen)."
    ],
    "donts": [
      "Don't change the typefaces, the dot-grid background or the palette: they are a binding product commitment.",
      "Don't use ember or slate for decoration; ember means a gap or failure, slate means compliant.",
      "Don't put a card inside a card, add an eyebrow label above a heading, or use gradient text.",
      "Don't let the one-screen desktop page scroll; let the register (and, in a very short window, the portfolio panel) scroll inside their own panels.",
      "Don't use the paper grain (.paper-bg) on product screens; it is for landing, auth and legal pages only.",
      "Don't open a modal for what an inline control or a popover can do; the drawer exists only for the forms that change data."
    ]
  }
}