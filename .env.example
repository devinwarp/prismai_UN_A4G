# Copy to .env.local (gitignored). This repo uses its OWN Supabase project,
# never main's. Setup: run supabase/schema.sql, then supabase/un-federal.sql, un-federal-t1.sql, un-federal-t2.sql (and seed-entities.sql after importing the use cases).

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-HACKATHON-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; the admin routes depend on it. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access ----------------------------------------------------------------
# Comma-separated emails that become workspace admins on first sign-in.
ADMIN_EMAILS=you@example.com

# --- Model provider (required for the role agents) ------------
# Any OpenAI-compatible endpoint. Defaults to OpenRouter.
OPENROUTER_API_KEY=your-openrouter-key   # key for the default OpenRouter endpoint
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5   # model id sent to the endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1   # OpenAI-compatible base URL
LLM_API_KEY=   # leave empty to use OPENROUTER_API_KEY; overrides it when set

# Amazon Bedrock with a Bedrock API key. The app only reads LLM_BASE_URL, LLM_API_KEY and the model variables below (it
# does not read AWS_BEARER_TOKEN_BEDROCK or AWS_REGION), so a Bedrock key goes in LLM_API_KEY. A bare bedrock-runtime
# host (no /openai path) makes the app call Bedrock's native Converse API: that is the only route that serves Claude.
# (Bedrock's OpenAI-compatible endpoints serve gpt-oss, Qwen, Mistral and others, but not Claude.) To use it, uncomment
# these and replace the OpenRouter values above:
# LLM_BASE_URL=https://bedrock-runtime.eu-central-1.amazonaws.com   # your Bedrock region; no path, no trailing slash
# LLM_API_KEY=                     # the Bedrock API key (sent as a Bearer token). Short-term keys expire: replace it when calls start returning 401/403
# OPENROUTER_MODEL=eu.anthropic.claude-sonnet-5-5   # default model: a Bedrock id or inference profile (eu.* for the EU regions)
# AGENT_LLM_MODEL=openai.gpt-oss-120b-1:0           # optional: the role agent's model, else OPENROUTER_MODEL
# GOAL_JUDGE_MODEL=qwen.qwen3-235b-a22b-2507-v1:0   # optional: the goal judge's model; keep it a different family from the agent

# Pre-inference screening: send the agent's model calls (ReAct reasoner, reflector, T12 drafter) through the
# Sijil node's OpenAI-compatible /v1 endpoint, which screens the exact prompt against its policy before
# inference. Unset = calls go straight to LLM_BASE_URL as before. When set, AGENT_LLM_MODEL and
# REFLECT_LLM_MODEL must be a model on the node's allowlist (the demo node allows only
# deepseek/deepseek-v4.1-flash). A node block ends the run as blocked_by_sijil — it is counted, never a fallback.
# AGENT_LLM_BASE_URL=https://sijil-node.onrender.com/v1
# AGENT_LLM_API_KEY=any-non-empty-value   # the node does not check it today; set one anyway
# TESTGEN_MODEL=eu.anthropic.claude-opus-5-5        # optional: the test-case generator; keep it a different family from the agent and the judge
# On Converse, non-Claude models take Bedrock ids with a version suffix (openai.gpt-oss-120b-1:0), unlike the plain ids
# the OpenAI-compatible mantle endpoint lists. The web-search tool (openrouter:web_search, used by the KB refresh) is not
# available on Bedrock. Ids Bedrock does not serve (anthropic/claude-sonnet-5.5, google/gemini-*) will fail.
# Docs: https://docs.aws.amazon.com/bedrock/latest/userguide/conversation-inference.html

# --- Site ------------------------------------------------------------------
# Used in links the app generates. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Live Sijil node (optional) -------------------------------------------
# Unset = simulated Sijil (default). Sijil is a separate product under its own
# licence; this app only calls its read-only HTTP API. See README.
# SIJIL_BASE_URL=https://your-tunnel.example     # http(s) only; link-local/metadata hosts rejected
# SIJIL_API_TOKEN=                               # sent as a Bearer header (put auth in front of the node)
# SIJIL_DISCLOSURE_RULE=                         # policy rule id whose hits count as ai_disclosure rejects; unset = not measured
# Seal every pilot run into the node (see README, "Seal every pilot run"). All four are needed; server only, never NEXT_PUBLIC_.
# SIJIL_AGENT_ID=                                 # spiffe://prism/agent/<name>, printed by scripts/sijil_register.ts
# SIJIL_AGENT_KEY=                                # Ed25519 seed, 64 hex characters, printed once by scripts/sijil_register.ts
# SIJIL_AGENT_TOKEN=                              # the node's shared agent token (X-Sijil-Token)

# Vector search for the KB endpoint. Unset = BM25 only (default). Set to "on" to add
# transformers.js query embedding + kb/vectors.json (needs the vectors built); falls
# back to BM25 if the model is slow or fails. KB_VECTOR_TIMEOUT_MS defaults to 8000.
KB_VECTOR=off   # "on" adds vector search to BM25; off = BM25 only

# --- Judge access + offline demo --------------------------------------------
# Comma-separated emails that become READ-ONLY judges (viewer role) on first sign-in.
# JUDGE_EMAILS=judge@example.com
# One-click judge button (/api/judge-login). Server only; see docs/final/judge-access.md.
# JUDGE_LOGIN_EMAIL=
# JUDGE_LOGIN_PASSWORD=
# JUDGE_ORG_ID=            # workspace judges see; default: the first admin's
# OFFLINE=1                # file-backed store in .data/, no Supabase, auto-signed-in admin.
#                          # Also on when the Supabase env is absent and NODE_ENV != production.
#                          # In production OFFLINE=1 is ignored unless OFFLINE_ALLOW_PRODUCTION=1 is also set (open admin: demo kit only).
# OFFLINE_ROLE=viewer      # preview the judge (read-only) experience offline
# Local model (LM Studio): LLM_BASE_URL=http://localhost:1234/v1  LLM_API_KEY=lm-studio  OPENROUTER_MODEL=<loaded model id>

# Cost ledger: dollars come from data/model-prices.json (USD per million tokens, from your provider's pricing). Optional override, same shape:
# MODEL_PRICES_JSON={"models":{"eu.anthropic.claude-sonnet-5-5":{"input":0,"output":0}},"tool_call":null}
