# Copy to .env.local (gitignored). This repo uses its OWN Supabase project,
# never main's. Setup: run supabase/schema.sql, then supabase/un-federal.sql, un-federal-t1.sql, un-federal-t2.sql (and seed-entities.sql after importing the use cases).

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-HACKATHON-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; the admin routes depend on it. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access ----------------------------------------------------------------
# Comma-separated emails that become workspace admins on first sign-in.
ADMIN_EMAILS=you@example.com

# --- Model provider (required for the role agents) ------------
# Any OpenAI-compatible endpoint. Defaults to OpenRouter.
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=            # overrides OPENROUTER_API_KEY when set
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- Site ------------------------------------------------------------------
# Used in links the app generates. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Live Sijil node (optional) -------------------------------------------
# Unset = simulated Sijil (default). Sijil is a separate product under its own
# licence; this app only calls its read-only HTTP API. See README.
# SIJIL_BASE_URL=https://your-tunnel.example     # http(s) only; link-local/metadata hosts rejected
# SIJIL_API_TOKEN=                               # sent as a Bearer header (put auth in front of the node)
# SIJIL_DISCLOSURE_RULE=                         # policy rule id whose hits count as ai_disclosure rejects; unset = not measured

# Vector search for the KB endpoint. Unset = BM25 only (default). Set to "on" to add
# transformers.js query embedding + kb/vectors.json (needs the vectors built); falls
# back to BM25 if the model is slow or fails. KB_VECTOR_TIMEOUT_MS defaults to 8000.
# KB_VECTOR=on
